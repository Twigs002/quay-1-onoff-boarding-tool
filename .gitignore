# web/config.js IS committed (like quay-hubspot/config.js): the Supabase anon key
# is public by design (Postgres RLS), and the Apps Script endpoint is public in the
# same way quay-hubspot exposes its endpoint. No private secret lives in it.

# Node / tooling
node_modules/
npm-debug.log*

# Agent tooling cruft (claude-flow scratch state, per-subdir)
.claude-flow/
**/.claude-flow/

# Binary docs / exports don't belong in source (keep the repo source-only;
# stash PDFs in docs/ intentionally or link them externally)
*.pdf

# OS / editor cruft
.DS_Store
*.log
*.swp
.idea/
.vscode/

# Python worker
__pycache__/
worker/__pycache__/
worker/**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
worker/.venv/

# Local secrets / creds
*.env
.env
worker/.env
worker/.env.*
!worker/.env.example
.clasp.json
apps-script/.clasp.json
.clasprc.json
worker/service-account*.json
worker/*-creds.json

# Playwright
worker/playwright-report/
worker/test-results/
worker/browser_profile/
apps-script/SeedAccounts.js
