# Quay 1 Boarding Tool - Python worker configuration.
# Copy to worker/.env and fill in. NEVER commit the real .env or the key file.

# Safety switch. "1" (default) = dry-run: log what we WOULD do, never submit a
# real create/deactivate on any portal. Set to "0" ONLY when the user explicitly
# arms live provisioning.
DRY_RUN=1

# The shared-bus Google Sheet (holds Provisioning Queue + Offboarding Queue tabs).
SHEET_ID=

# Path to the Google service-account JSON key (gitignored, same pattern as
# virtual-agent-lookup's va-automation-*-key.json). The service account must be
# shared as an editor on the SHEET_ID sheet.
GOOGLE_KEY_PATH=./service-account.json

# Run browsers headless ("1") or visible ("0", useful for debugging selectors).
HEADLESS=1

# How many pending rows to claim+process per poll pass (0 = no limit).
MAX_ROWS_PER_PASS=25

# Give up on a queue row after this many failed attempts.
MAX_ATTEMPTS=3

# macOS Keychain service names holding each portal's admin password.
# Look up with: security find-generic-password -s <service> -a <account> -w
# Add one with:  security add-generic-password -s <service> -a <account> -w
CMA_KEYCHAIN_SERVICE=cma-info
DIALFIRE_KEYCHAIN_SERVICE=dialfire-admin
PROPDATA_KEYCHAIN_SERVICE=propdata-admin

# Portal admin usernames (the account the worker logs in as to manage seats).
CMA_ADMIN_USER=
DIALFIRE_ADMIN_USER=
PROPDATA_ADMIN_USER=

# PropData (PDMS) specifics. Company id is the /secure/<id>/ segment of the admin
# URL (Quay 1 = 46). Default profile photo ships in the repo (worker/assets/);
# full-status agents get a per-person Canva headshot via the queue payload instead.
PROPDATA_COMPANY_ID=46
PROPDATA_BRANCH=Quay 1 International Realty
# PROPDATA_DEFAULT_PHOTO=./assets/quay1_profile.png
